[
  {
    "id": "mon_01m77t22g0tpxfvf3bvkqaj4sb",
    "name": "GitHub status page API",
    "url": "https://www.githubstatus.com/api/v2/status.json",
    "tags": [
      "status-page",
      "vendor"
    ],
    "assertions": [
      {
        "source": "status",
        "op": "eq",
        "target": 200
      },
      {
        "source": "json",
        "property": "status.indicator",
        "op": "eq",
        "target": "none"
      },
      {
        "source": "latency_ms",
        "op": "lt",
        "target": 1500
      }
    ],
    "interval_s": 900,
    "timeout_ms": 10000,
    "failure_threshold": 2,
    "slo_target": 0.995
  },
